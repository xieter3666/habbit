<view class="modal-overlay {{show ? 'show' : ''}}" wx:if="{{show}}" bindtap="onMaskClick">
  <view class="modal-card" catchtap="stopBubble">
    <view class="modal-header">
      <view class="header-left">
        <text class="modal-icon" wx:if="{{icon}}">{{icon}}</text>
        <text class="modal-title">{{title}}</text>
      </view>
      <view class="close-btn" bindtap="onClose">✕</view>
    </view>

    <view class="modal-body">
      <slot></slot>
    </view>
  </view>
</view>
