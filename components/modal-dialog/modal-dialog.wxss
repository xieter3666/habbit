.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(40, 35, 30, 0.55);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.modal-overlay.show {
  opacity: 1;
}

.modal-card {
  background: #FFFFFF;
  border-radius: 40rpx;
  width: 100%;
  max-width: 660rpx;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(100, 75, 50, 0.2);
  border: 4rpx solid #F2ECE0;
  animation: popIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes popIn {
  from { transform: scale(0.85); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-header {
  padding: 32rpx 36rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #F5F1E8;
}

.header-left {
  display: flex;
  align-items: center;
}

.modal-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A4238;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F4EFE6;
  color: #8C8477;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  cursor: pointer;
}

.close-btn:active {
  background: #E8E0D2;
}

.modal-body {
  padding: 32rpx 36rpx 40rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
