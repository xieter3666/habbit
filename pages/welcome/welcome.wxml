<view class="welcome-container">
  <view class="welcome-content">
    <view class="logo-box anim-float">
      <image class="brand-logo" src="/assets/logo.png" mode="aspectFit" />
    </view>

    <view class="text-box">
      <text class="title-text">不止日常</text>
      <text class="tagline">在不止日常，遇见更好的自己～</text>
      <text class="intro-text">
        完成每日自律任务，收集金灿灿的小星星，与毛茸茸的萌宠伙伴把平凡的日常过成一场温柔浪漫的冒险。
      </text>
    </view>

    <view class="features-list">
      <view class="feature-item">
        <text class="fi-icon">🌱</text>
        <text class="fi-text">每日打卡 · 记录微光</text>
      </view>
      <view class="feature-item">
        <text class="fi-icon">🐾</text>
        <text class="fi-text">萌宠乐园 · 治愈相伴</text>
      </view>
      <view class="feature-item">
        <text class="fi-icon">🏡</text>
        <text class="fi-text">温馨小屋 · 装扮成长</text>
      </view>
    </view>

    <button class="bzd-btn bzd-btn--green start-btn" bindtap="handleEnterApp">
      <text>开启美好一天 ›</text>
    </button>
  </view>
</view>
