@import "../mine/mine.wxss";

/* ================= 页面主容器 (沉浸式全屏) ================= */
.room-page-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #F7F4EB;
  position: relative;
}

/* ================= 1. 顶部极简沉浸状态条 ================= */
.room-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 16rpx) 28rpx 16rpx;
  background: rgba(247, 244, 235, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 50;
  border-bottom: 2rpx solid rgba(220, 210, 195, 0.4);
}

.rh-user-chip {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  padding: 8rpx 18rpx 8rpx 8rpx;
  border-radius: 999rpx;
  border: 2rpx solid #EAE3D5;
  box-shadow: 0 4rpx 10rpx rgba(160, 140, 110, 0.08);
}

.rh-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 2rpx solid #E0D6C3;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.rh-user-text {
  display: flex;
  flex-direction: column;
}

.rh-name-line {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.rh-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #4A4238;
}

.rh-leaf {
  font-size: 22rpx;
}

.rh-level-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.rh-level {
  font-size: 20rpx;
  font-weight: 700;
  color: #5C7C57;
  background: #E8F0E5;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.rh-exp-track {
  width: 90rpx;
  height: 8rpx;
  background: #EAE3D5;
  border-radius: 4rpx;
  overflow: hidden;
}

.rh-exp-fill {
  height: 100%;
  background: linear-gradient(90deg, #A8C69F, #6A8E61);
  border-radius: 4rpx;
}

.rh-exp-val {
  font-size: 18rpx;
  color: #9E9689;
}

.rh-right-pills {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rh-sync-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(160, 140, 110, 0.06);
}

.rh-sync-pill.synced {
  background: #EDF5EC;
  color: #4B6E47;
  border: 2rpx solid #D2E4D0;
}

.rh-sync-pill.local {
  background: #FAF3E8;
  color: #8C6F3E;
  border: 2rpx solid #EBE0CE;
}

.sync-dot {
  font-size: 14rpx;
}

.rh-weather-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  border: 2rpx solid #EAE3D5;
  font-size: 22rpx;
  font-weight: 600;
  color: #5A5245;
}

/* ================= 2. 核心大场景舞台 (Room Stage) ================= */
.room-stage-box {
  flex: 1;
  position: relative;
  width: 100%;
  overflow: hidden;
}

/* A. 背景层 */
.stage-layer-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

.stage-bg-img {
  width: 100%;
  height: 100%;
}

/* B. 墙面木质荣誉展示架 */
.stage-layer-honor {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  z-index: 15;
}

.wooden-honor-shelf {
  background: #EFE4CE;
  border: 2rpx solid #D6C2A0;
  border-radius: 18rpx;
  padding: 10rpx 16rpx 8rpx;
  box-shadow: 0 6rpx 16rpx rgba(110, 85, 50, 0.16);
  display: flex;
  flex-direction: column;
}

.shelf-header {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.sh-icon {
  font-size: 20rpx;
}

.sh-title {
  font-size: 20rpx;
  font-weight: 700;
  color: #634C2B;
}

.sh-count {
  font-size: 18rpx;
  color: #8A7250;
  margin-left: auto;
}

.shelf-rack {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mini-badge-slot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid #DFCEB2;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.mini-badge-slot.locked {
  opacity: 0.45;
  filter: grayscale(1);
}

.mini-badge-icon {
  width: 32rpx;
  height: 32rpx;
}

.mini-badge-glow {
  position: absolute;
  inset: -4rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(220, 170, 70, 0.4);
}

.shelf-wood-ledge {
  height: 6rpx;
  background: #BFA885;
  border-radius: 3rpx;
  margin-top: 6rpx;
}

/* C. 视觉中心：卡通角色主体 (占场景约 75% 比重) */
.stage-layer-character {
  position: absolute;
  left: 50%;
  bottom: 80rpx;
  transform: translateX(-50%);
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: auto;
}

.character-speech-bubble {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 2rpx solid #EAE3D5;
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(140, 115, 80, 0.15);
  position: relative;
  max-width: 480rpx;
}

.character-speech-bubble::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid rgba(255, 255, 255, 0.95);
}

.csb-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #4A4238;
}

.character-avatar-wrap {
  width: 400rpx;
  height: 600rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.character-body-img {
  width: 100%;
  height: 100%;
}

.character-feet-shadow {
  width: 260rpx;
  height: 24rpx;
  background: radial-gradient(ellipse at center, rgba(140, 120, 90, 0.35) 0%, rgba(140, 120, 90, 0) 70%);
  margin-top: -12rpx;
}

/* D. 陪伴宠物 (右侧地毯) */
.stage-layer-pet {
  position: absolute;
  right: 60rpx;
  bottom: 80rpx;
  z-index: 22;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pet-heart-effect {
  position: absolute;
  top: -40rpx;
  background: #FFF2F2;
  border: 2rpx solid #F5C6C6;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #E25858;
  animation: floatHeart 1s ease-out forwards;
}

@keyframes floatHeart {
  0% { transform: translateY(0) scale(0.8); opacity: 0; }
  30% { transform: translateY(-10rpx) scale(1.1); opacity: 1; }
  100% { transform: translateY(-30rpx) scale(1); opacity: 0; }
}

.room-companion-pet {
  width: 170rpx;
  height: 130rpx;
}

.pet-feet-shadow {
  width: 140rpx;
  height: 16rpx;
  background: radial-gradient(ellipse at center, rgba(140, 120, 90, 0.35) 0%, rgba(140, 120, 90, 0) 70%);
  margin-top: -8rpx;
}

/* E. 独立悬浮工具箱图标 (右下角常驻入口) */
.stage-layer-toolbox-fab {
  position: absolute;
  right: 28rpx;
  bottom: 140rpx;
  z-index: 30;
}

.toolbox-fab-btn {
  background: #FCFBF7;
  border: 2rpx solid #C4D6BF;
  box-shadow: 0 8rpx 24rpx rgba(100, 130, 90, 0.22);
  border-radius: 999rpx;
  padding: 10rpx 20rpx 10rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.toolbox-fab-btn:active {
  transform: scale(0.93);
}

.tfb-icon-circle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #E8F2E4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tfb-emoji {
  font-size: 28rpx;
}

.tfb-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #3E5A37;
}

.tfb-arrow {
  font-size: 24rpx;
  color: #7A9B72;
}


/* ================= 4. 工具箱抽屉面板 (Drawer Sheet) ================= */
.drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(30, 24, 16, 0.45);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 1050;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.28s ease;
}

.drawer-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.toolbox-drawer-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1100;
  background: #FAF7F0;
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -10rpx 40rpx rgba(60, 45, 30, 0.2);
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.32s cubic-bezier(0.2, 0.9, 0.3, 1);
}

.toolbox-drawer-wrap.open {
  transform: translateY(0);
}

.drawer-header {
  padding: 20rpx 32rpx 16rpx;
  border-bottom: 2rpx solid #EAE3D5;
}

.drawer-drag-pill {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #D8CEBC;
  margin: 0 auto 16rpx;
}

.drawer-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.dt-left {
  display: flex;
  flex-direction: column;
}

.dt-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4238;
}

.dt-sub {
  font-size: 20rpx;
  color: #9E9689;
  margin-top: 4rpx;
}

.drawer-close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #EFE8DA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-x {
  font-size: 26rpx;
  font-weight: 700;
  color: #7A7062;
}

.drawer-tabs-strip {
  display: flex;
  background: #EBE3D3;
  border-radius: 20rpx;
  padding: 6rpx;
  gap: 8rpx;
}

.d-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 0;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.d-tab.active {
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(120, 100, 70, 0.12);
}

.d-tab-icon {
  font-size: 24rpx;
}

.d-tab-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #7A7062;
}

.d-tab.active .d-tab-text {
  color: #45683F;
}

.drawer-content-scroll {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.panel-hint-bar {
  margin-bottom: 20rpx;
}

.ph-text {
  font-size: 22rpx;
  color: #8C8272;
}

/* 装扮网格 */
.outfit-items-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.outfit-grid-card {
  background: #FFFFFF;
  border: 2rpx solid #EBE4D5;
  border-radius: 24rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(160, 140, 110, 0.06);
}

.outfit-grid-card.equipped {
  border-color: #A0C296;
  background: #F8FBF6;
}

.ogc-img-box {
  width: 110rpx;
  height: 110rpx;
  background: #FAF6ED;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 12rpx;
}

.ogc-icon {
  width: 80rpx;
  height: 80rpx;
}

.ogc-equipped-badge {
  position: absolute;
  bottom: 4rpx;
  background: #5C7C57;
  color: #FFFFFF;
  font-size: 16rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.ogc-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #4A4238;
  margin-bottom: 12rpx;
}

.ogc-btn {
  width: 100%;
  font-size: 20rpx;
  padding: 6rpx 0;
}

/* 背景列表 */
.bg-themes-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.bg-theme-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #EBE4D5;
  border-radius: 24rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 10rpx rgba(160, 140, 110, 0.06);
}

.bg-theme-card.active-bg {
  border-color: #8EBA83;
  background: #F7FAF5;
}

.btc-thumb {
  width: 130rpx;
  height: 90rpx;
  border-radius: 14rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.btc-info {
  flex: 1;
}

.btc-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.btc-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #4A4238;
}

.btc-tag {
  font-size: 18rpx;
  color: #5C7C57;
  background: #E6EFE4;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.btc-desc {
  font-size: 20rpx;
  color: #9E9689;
  margin-top: 4rpx;
}

.btc-action {
  font-size: 20rpx;
  padding: 8rpx 20rpx;
}

/* 抽屉宠物列表 */
.pet-meadow-jump-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E6F2E2 0%, #D4E8CF 100%);
  border: 2rpx solid #B8D6B0;
  border-radius: 24rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
}

.pmj-icon {
  font-size: 36rpx;
  margin-right: 14rpx;
}

.pmj-info {
  flex: 1;
}

.pmj-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #35532F;
}

.pmj-sub {
  font-size: 18rpx;
  color: #5D7958;
  margin-top: 2rpx;
}

.pets-drawer-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pet-drawer-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #EBE4D5;
  border-radius: 24rpx;
  padding: 16rpx;
}

.pet-drawer-card.selected {
  border-color: #8EBA83;
  background: #F7FAF5;
}

.pdc-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.pdc-info {
  flex: 1;
}

.pdc-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pdc-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #4A4238;
}

.pdc-species {
  font-size: 20rpx;
  color: #9E9689;
}

.pdc-badge {
  font-size: 18rpx;
  color: #D48828;
  background: #FCF4E8;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.pdc-desc {
  font-size: 20rpx;
  color: #8A8072;
  margin-top: 4rpx;
}

.pdc-status-row {
  display: flex;
  gap: 16rpx;
  margin-top: 6rpx;
}

.status-lbl {
  font-size: 18rpx;
  color: #9E9689;
}

.pdc-btn {
  font-size: 20rpx;
  padding: 8rpx 18rpx;
}

.pdc-locked {
  font-size: 20rpx;
  color: #A0988A;
}

/* 生活工具网格 */
.tools-drawer-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.tool-tile {
  background: #FFFFFF;
  border: 2rpx solid #EBE4D5;
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(160, 140, 110, 0.06);
}

.tool-tile:active {
  transform: scale(0.96);
}

.tool-tile-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 10rpx;
}

.tool-tile-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #4A4238;
}

.tool-tile-desc {
  font-size: 18rpx;
  color: #9E9689;
  margin-top: 4rpx;
}

.drawer-safe-padding {
  height: calc(env(safe-area-inset-bottom) + 60rpx);
}

/* 荣誉勋章详情弹窗 */
.honor-modal-detail {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
}

.hmd-badge-img {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 16rpx;
}

.hmd-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A4238;
  margin-bottom: 8rpx;
}

.hmd-status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}

.hmd-status.unlocked {
  background: #E8F2E4;
  color: #486E42;
}

.hmd-status.locked {
  background: #F0EDE5;
  color: #9E9689;
}

.hmd-info-box {
  width: 100%;
  background: #FAF6ED;
  border-radius: 18rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hmd-row {
  font-size: 22rpx;
  color: #6A6052;
  line-height: 1.5;
}

/* 微动画 */
.anim-breathe {
  animation: gentleBreathe 4s ease-in-out infinite alternate;
}

@keyframes gentleBreathe {
  0% { transform: scale(1); }
  100% { transform: scale(1.02); }
}

.anim-bounce-gentle {
  animation: bounceGentle 3s ease-in-out infinite;
}

@keyframes bounceGentle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}
