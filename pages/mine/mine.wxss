  background: #FAF8F2;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #EFEAE0;
  position: relative;
}

.sni-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sni-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A4238;
}

.sni-date {
  font-size: 18rpx;
  color: #8C8477;
}

.sni-content {
  font-size: 22rpx;
  color: #6E6659;
  line-height: 1.4;
  display: block;
}

.sni-del {
  font-size: 20rpx;
  color: #D46A6A;
  margin-top: 8rpx;
  display: inline-block;
  cursor: pointer;
}

.focus-clock-ring {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 8rpx solid #7FA277;
  background: #F4EFE6;
  margin: 20rpx auto 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.focus-timer-text {
  font-size: 56rpx;
  font-weight: 800;
  color: #4A4238;
}

.focus-mode-text {
  font-size: 20rpx;
  color: #5C7C57;
  margin-top: 6rpx;
}

.focus-stats-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 28rpx;
}

.fs-text {
  font-size: 22rpx;
  color: #8C8477;
}

.focus-actions {
  display: flex;
  gap: 16rpx;
}

.fa-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 24rpx;
}

.cal-month-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.cal-month-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A4238;
}

.cal-month-streak {
  font-size: 22rpx;
  color: #5C7C57;
  font-weight: 600;
}

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 22rpx;
  color: #8C8477;
  margin-bottom: 16rpx;
}

.cal-days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.cal-day-cell {
  height: 70rpx;
  border-radius: 16rpx;
  background: #FAF8F2;
  border: 1rpx solid #EFEAE0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cal-day-cell.checked-day {
  background: #FDF5E7;
  border-color: #F5C68A;
}

.cal-day-cell.today-day {
  border: 3rpx solid #7FA277;
  font-weight: 700;
}

.cal-day-num {
  font-size: 22rpx;
  color: #4A4238;
}

.cal-paw-mark {
  font-size: 16rpx;
}

.ach-detail-card {
  display: flex;
  align-items: center;
  background: #FAF8F2;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #EFEAE0;
}

.adc-badge {
  width: 90rpx;
  height: 90rpx;
  margin-right: 20rpx;
}

.adc-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.adc-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.adc-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A4238;
}

.adc-status {
  font-size: 20rpx;
}

.adc-status.unlocked { color: #5C7C57; font-weight: 600; }
.adc-status.locked { color: #8C8477; }

.adc-desc {
  font-size: 20rpx;
  color: #6E6659;
  margin: 6rpx 0 2rpx;
}

.mp-field {
  margin-bottom: 20rpx;
}

.mp-label {
  font-size: 24rpx;
  color: #6E6659;
  margin-bottom: 8rpx;
  display: block;
}

.msg-card, .ex-card {
  background: #FAF8F2;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #EFEAE0;
}

.msg-header, .ex-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.msg-title, .ex-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #4A4238;
}

.msg-time, .ex-cost {
  font-size: 20rpx;
  color: #D48828;
}

.msg-body, .ex-date {
  font-size: 22rpx;
  color: #6E6659;
  line-height: 1.4;
}

.about-logo {
  width: 140rpx;
  height: 140rpx;
  display: block;
  margin: 0 auto 16rpx;
}

.about-app-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #4A4238;
  text-align: center;
  display: block;
}

.about-slogan {
  font-size: 22rpx;
  color: #5C7C57;
  text-align: center;
  display: block;
  margin: 6rpx 0 20rpx;
}

.about-desc {
  font-size: 22rpx;
  color: #6E6659;
  line-height: 1.6;
  text-align: justify;
  display: block;
}
