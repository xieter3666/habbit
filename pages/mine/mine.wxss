.mine-container {
  min-height: 100vh;
  background-color: #F7F4EB;
  position: relative;
  padding-bottom: 30rpx;
}

/* ================= 顶部自定义导航与模态切换 ================= */
.mine-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 20rpx) 32rpx 20rpx;
  background: #F7F4EB;
  position: sticky;
  top: 0;
  z-index: 100;
}

.view-mode-tabs {
  display: flex;
  background: #EAE3D5;
  border-radius: 999rpx;
  padding: 6rpx;
}

.mode-pill {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #7A7062;
  transition: all 0.25s ease;
}

.mode-pill.active {
  background: #FFFFFF;
  color: #4A4238;
  box-shadow: 0 4rpx 12rpx rgba(130, 110, 80, 0.15);
}

.topbar-right-actions {
  display: flex;
  gap: 16rpx;
}

.icon-circle-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #EAE3D5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(160, 140, 110, 0.08);
}

.icon-circle-btn:active {
  transform: scale(0.92);
}

.topbar-emoji {
  font-size: 28rpx;
}

/* ============================================================== */
/* 模态 A：温馨小屋场景态 (Scene Mode)                             */
/* ============================================================== */
.scene-view-wrap {
  padding: 0 28rpx;
}

/* 顶部用户卡片 */
.scene-header-card {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FCFBF7;
}

.sh-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.sh-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 4rpx solid #EBE4D5;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.sh-info {
  display: flex;
  flex-direction: column;
}

.sh-name-row {
  display: flex;
  align-items: center;
}

.sh-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A4238;
}

.sh-leaf {
  font-size: 28rpx;
  margin-left: 6rpx;
}

.sh-bio {
  font-size: 20rpx;
  color: #8C8477;
  margin: 4rpx 0 8rpx;
}

.sh-lv-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.sh-lv {
  font-size: 20rpx;
  font-weight: 700;
  color: #5C7C57;
}

.sh-exp-bar {
  width: 100rpx;
  height: 10rpx;
  background: #EBE5D8;
  border-radius: 5rpx;
  overflow: hidden;
}

.sh-exp-inner {
  height: 100%;
  background: #7FA277;
}

.sh-exp-text {
  font-size: 18rpx;
  color: #A39B8F;
}

.sh-title-badge {
  background: #FDF5E7;
  border-radius: 12rpx;
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  color: #D48828;
  font-weight: 600;
}

.sh-weather {
  display: flex;
  align-items: center;
  background: #FAF8F2;
  border: 2rpx solid #EFEAE0;
  border-radius: 20rpx;
  padding: 10rpx 14rpx;
  flex-shrink: 0;
}

.sh-weather-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.sh-weather-text {
  display: flex;
  flex-direction: column;
}

.wt-temp {
  font-size: 22rpx;
  font-weight: 600;
  color: #4A4238;
}

.wt-loc {
  font-size: 18rpx;
  color: #8C8477;
}

/* 统计数据条 */
.scene-stats-strip {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  background: #FAF8F2;
}

.stat-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sp-icon {
  font-size: 24rpx;
}

.sp-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A4238;
}

.sp-label {
  font-size: 22rpx;
  color: #8C8477;
}

.stat-divider {
  width: 2rpx;
  height: 28rpx;
  background: #EAE3D5;
}

/* 温馨房间交互画布 */
.room-scene-box {
  width: 100%;
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 40rpx;
}

.room-bg-img {
  width: 100%;
  display: block;
}

.character-speech-bubble {
  position: absolute;
  top: 6%;
  left: 14%;
  max-width: 50%;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 20rpx;
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #4A4238;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(100, 80, 50, 0.15);
  border: 2rpx solid #EFEAE0;
  cursor: pointer;
  z-index: 10;
}

.character-speech-bubble::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  right: 28rpx;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #FFFFFF;
}

.room-girl-touch {
  position: absolute;
  left: 20%;
  top: 25%;
  width: 28%;
  height: 65%;
  z-index: 9;
  cursor: pointer;
}

.room-cat-touch {
  position: absolute;
  bottom: 8%;
  left: 52%;
  width: 20%;
  height: 35%;
  z-index: 10;
  cursor: pointer;
}

.touch-hint-heart {
  position: absolute;
  top: -30rpx;
  left: 40rpx;
  font-size: 36rpx;
  animation: heartFloat 1.2s ease-out forwards;
}

.scene-float-actions {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  z-index: 10;
}

.scene-float-btn {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 36rpx;
  padding: 10rpx 18rpx;
  box-shadow: 0 6rpx 16rpx rgba(100, 80, 50, 0.12);
  border: 2rpx solid #EFEAE0;
}

.scene-float-btn:active {
  transform: scale(0.95);
}

.sfb-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.sfb-col {
  display: flex;
  flex-direction: column;
}

.sfb-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #4A4238;
}

.sfb-sub {
  font-size: 18rpx;
  color: #7FA277;
  font-weight: 500;
}

/* 我的工具箱 */
.toolbox-section {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  background: #FCFBF7;
}

.section-title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.st-left {
  display: flex;
  align-items: center;
}

.st-leaf {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.st-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4238;
}

.st-arrow {
  font-size: 28rpx;
  color: #8C8477;
}

.st-more-link {
  font-size: 22rpx;
  color: #8C8477;
}

.toolbox-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12rpx;
}

.toolbox-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s ease;
}

.toolbox-item:active {
  transform: scale(0.92);
}

.tool-icon {
  width: 84rpx;
  height: 84rpx;
}

.tool-label {
  font-size: 20rpx;
  color: #6E6659;
  margin-top: 6rpx;
}

/* 我的成就 */
.achievements-section {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  background: #FCFBF7;
}

.achievements-row {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
}

.ach-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  text-align: center;
}

.ach-item:active {
  transform: scale(0.95);
}

.ach-badge-img {
  width: 100rpx;
  height: 100rpx;
}

.ach-name {
  font-size: 20rpx;
  font-weight: 600;
  color: #4A4238;
  margin-top: 6rpx;
}

.ach-sub {
  font-size: 16rpx;
  color: #9C9487;
  margin-top: 2rpx;
}

.ach-item.locked {
  opacity: 0.6;
}

